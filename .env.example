# Optional model providers
GHOSTCHIMERA_MODEL_PROVIDER=minimind
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic (Claude) provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Nebius Token Factory (NVIDIA Nemotron inference) — powers the Stealth
# Loop's optional cloud reasoning. Get a key at https://console.nebius.com
# (Token Factory -> API keys); free credits via the Nebius Builder Program.
NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# 1 = let the Stealth Loop consult Nemotron when NEBIUS_API_KEY is set (default)
GHOSTCHIMERA_NEBIUS_REASONING=1

# Tavily web grounding (Stealth Loop UNDERSTAND phase).
# MCP-first (remote https://mcp.tavily.com/mcp, then local npx tavily-mcp),
# direct REST fallback. Get a key at https://tavily.com
TAVILY_API_KEY=
# TAVILY_MCP_MODE: auto | remote | local | rest  (default: auto)
# TAVILY_MCP_URL=https://mcp.tavily.com/mcp
# TAVILY_MCP_COMMAND=npx -y tavily-mcp

# Optional LangSmith tracing for the Nebius + Tavily integration paths.
# Unset = tracing fully disabled, zero behavior change.
LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=ghost-chimera-hackathon
# LANGSMITH_TRACING=1   # set to 0 to disable while keeping the key around

# Optional local state
GHOSTCHIMERA_STATE_DIR=~/.ghostchimera
GHOSTCHIMERA_MEMORY_DB=~/.ghostchimera/memory.sqlite3
GHOSTCHIMERA_AUDIT_FILE=~/.ghostchimera/audit.json

# Legacy JSON memory helper
GHOSTCHIMERA_MEMORY_FILE=~/.ghostchimera/memory.json
